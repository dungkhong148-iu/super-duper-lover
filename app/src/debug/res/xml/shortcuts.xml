            <extra
                android:name="com.superduperlover.finance.KIND"
                android:value="INCOME" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="quick_transfer"
        android:enabled="true"
        android:icon="@drawable/ic_wallet"
        android:shortcutShortLabel="@string/shortcut_transfer_short"
        android:shortcutLongLabel="@string/shortcut_transfer_long">
        <intent
            android:action="android.intent.action.VIEW"
